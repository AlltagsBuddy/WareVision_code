# WareVision – Einstellungen für den Server
# Kopieren nach .env (im Ordner mit docker-compose.prod.yml) und ausfüllen.
# Diese Datei NIE in Git einchecken oder weitergeben.

# Adresse ohne https://, z. B. quadparadies.warevision.de
WAREVISION_DOMAIN=

# Lange Zufallswerte – NUR so erzeugen (nur Ziffern und a–f, keine Sonderzeichen):
#   openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=

# Port, auf dem WareVision lokal auf dem Server lauscht (für den vorhandenen Webserver)
HTTP_PORT=8080

# Selbstregistrierung über /register (false = nur Admin legt Benutzer an)
REGISTRATION_ENABLED=false

# Nur für eine neue, leere Installation ohne Datenübernahme vom PC:
# erster Admin (Passwort mind. 10 Zeichen). Danach wieder leeren.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Ordner für die tägliche Sicherung auf dem Server
BACKUP_PATH=./backups

# Optional: Fehlerüberwachung
SENTRY_DSN=
